{
  "realm": "meterya",
  "enabled": true,
  "loginTheme": "meterya",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "webAuthnPolicyRpEntityName": "meterya",
  "webAuthnPolicyUserVerificationRequirement": "required",
  "webAuthnPolicyPasswordlessRpEntityName": "meterya",
  "webAuthnPolicyPasswordlessUserVerificationRequirement": "required",
  "browserFlow": "Meterya browser",
  "requiredActions": [
    {"alias": "UPDATE_PASSWORD", "name": "Update Password", "providerId": "UPDATE_PASSWORD", "enabled": true, "defaultAction": false, "priority": 30},
    {"alias": "CONFIGURE_TOTP", "name": "Configure OTP", "providerId": "CONFIGURE_TOTP", "enabled": true, "defaultAction": false, "priority": 40},
    {"alias": "VERIFY_EMAIL", "name": "Verify Email", "providerId": "VERIFY_EMAIL", "enabled": true, "defaultAction": false, "priority": 50},
    {"alias": "UPDATE_EMAIL", "name": "Update Email", "providerId": "UPDATE_EMAIL", "enabled": true, "defaultAction": false, "priority": 50, "config": {"verify-email": "true"}},
    {"alias": "webauthn-register", "name": "WebAuthn Register", "providerId": "webauthn-register", "enabled": true, "defaultAction": false, "priority": 51},
    {"alias": "webauthn-register-passwordless", "name": "WebAuthn Register Passwordless", "providerId": "webauthn-register-passwordless", "enabled": true, "defaultAction": false, "priority": 52},
    {"alias": "CONFIGURE_RECOVERY_AUTHN_CODES", "name": "Configure Recovery Codes", "providerId": "CONFIGURE_RECOVERY_AUTHN_CODES", "enabled": true, "defaultAction": false, "priority": 53},
    {"alias": "meterya-configure-factor", "name": "Choose and configure second factor", "providerId": "meterya-configure-factor", "enabled": true, "defaultAction": false, "priority": 60}
  ],
  "attributes": {"acr.loa.map": "{\"1\":1,\"2\":2}"},
  "smtpServer": {"host": "__SMTP_HOST__", "port": "__SMTP_PORT__", "from": "__SMTP_FROM__", "auth": "true", "user": "__SMTP_USER__", "password": "__SMTP_PASSWORD__", "ssl": "false", "starttls": "true"},
  "clients": [
    {
      "clientId": "meterya-web", "enabled": true,
      "protocol": "openid-connect", "publicClient": false,
      "secret": "__OIDC_CLIENT_SECRET__", "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["__PUBLIC_ORIGIN__/auth/callback", "__PUBLIC_ORIGIN__/invitations/accept*"],
      "webOrigins": ["__PUBLIC_ORIGIN__"],
      "defaultClientScopes": ["profile", "email", "acr"],
      "attributes": {"pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "__PUBLIC_ORIGIN__/"}
    },
    {
      "clientId": "meterya-invitations", "enabled": true,
      "protocol": "openid-connect", "publicClient": false,
      "secret": "__KEYCLOAK_SERVICE_SECRET__", "serviceAccountsEnabled": true,
      "standardFlowEnabled": false, "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {"username": "service-account-meterya-invitations", "serviceAccountClientId": "meterya-invitations", "enabled": true,
      "clientRoles": {"realm-management": ["manage-users", "query-users"]}}
  ],
  "authenticatorConfig": [
    {"alias": "Meterya level 1", "config": {"loa-condition-level": "1", "loa-max-age": "28800"}},
    {"alias": "Meterya level 2", "config": {"loa-condition-level": "2", "loa-max-age": "0"}}
  ],
  "authenticationFlows": [
    {"alias": "Meterya browser", "providerId": "basic-flow", "topLevel": true, "builtIn": false,
      "authenticationExecutions": [
        {"authenticator": "auth-cookie", "requirement": "ALTERNATIVE", "priority": 10, "authenticatorFlow": false},
        {"flowAlias": "Meterya authentication", "requirement": "ALTERNATIVE", "priority": 20, "authenticatorFlow": true}]},
    {"alias": "Meterya authentication", "providerId": "basic-flow", "topLevel": false, "builtIn": false,
      "authenticationExecutions": [
        {"flowAlias": "Meterya password", "requirement": "CONDITIONAL", "priority": 10, "authenticatorFlow": true},
        {"flowAlias": "Meterya second factor", "requirement": "CONDITIONAL", "priority": 20, "authenticatorFlow": true}]},
    {"alias": "Meterya password", "providerId": "basic-flow", "topLevel": false, "builtIn": false,
      "authenticationExecutions": [
        {"authenticator": "conditional-level-of-authentication", "authenticatorConfig": "Meterya level 1", "requirement": "REQUIRED", "priority": 10, "authenticatorFlow": false},
        {"authenticator": "auth-username-password-form", "requirement": "REQUIRED", "priority": 20, "authenticatorFlow": false}]},
    {"alias": "Meterya second factor", "providerId": "basic-flow", "topLevel": false, "builtIn": false,
      "authenticationExecutions": [
        {"authenticator": "conditional-level-of-authentication", "authenticatorConfig": "Meterya level 2", "requirement": "REQUIRED", "priority": 10, "authenticatorFlow": false},
        {"flowAlias": "Meterya factor choice", "requirement": "REQUIRED", "priority": 20, "authenticatorFlow": true}]},
    {"alias": "Meterya factor choice", "providerId": "basic-flow", "topLevel": false, "builtIn": false,
      "authenticationExecutions": [
        {"authenticator": "auth-otp-form", "requirement": "ALTERNATIVE", "priority": 10, "authenticatorFlow": false},
        {"authenticator": "webauthn-authenticator-passwordless", "requirement": "ALTERNATIVE", "priority": 20, "authenticatorFlow": false},
        {"authenticator": "webauthn-authenticator", "requirement": "ALTERNATIVE", "priority": 30, "authenticatorFlow": false},
        {"authenticator": "auth-recovery-authn-code-form", "requirement": "ALTERNATIVE", "priority": 40, "authenticatorFlow": false}]}
  ]
}
